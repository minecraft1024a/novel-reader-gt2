<div style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
  <list ref="settingList" on:swipe="swipeBack" style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.screenHeight}}px;">
    <list-item class="timeBatteryWrapper" style="width: {{uiSizes.screenWidth}}px; height: {{uiSizes.topMargin + 24}}px;"><text class="text-30px timeBatteryStr">{{timeBatteryStr}}</text></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 96px; justify-content: center;"><stack style="width: {{uiSizes.uiWidth}}px; height: 72px;"><text class="text-38px title-text">阅读设置</text><div on:click="back" class="ui-round-btn" style="left: {{uiSizes.uiWidth - 72}}px;"><image style="width: 44px; height: 44px;" src="/common/chevron_left-44px.png"></image></div></stack></list-item>
    <list-item class="main-card-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 204px;"><div class="main-card" style="width: {{uiSizes.uiWidth}}px; height: 192px;"><text class="main-card-title">背景与文字颜色</text><list class="option-list" style="width: {{uiSizes.uiWidth}}px; height: 84px; padding-left: 0px; padding-right: 0px;"><list-item class="option-card-wrapper"><div on:click="changeTheme('纯黑')" class="option-card" style="background-color: #000;"><text style="color: #fff; font-size: 28px;">黑</text></div></list-item><list-item class="option-card-wrapper"><div on:click="changeTheme('纯白')" class="option-card" style="background-color: #fff;"><text style="color: #000; font-size: 28px;">白</text></div></list-item><list-item class="option-card-wrapper"><div on:click="changeTheme('深灰')" class="option-card" style="background-color: #333;"><text style="color: #ddd; font-size: 28px;">灰</text></div></list-item><list-item class="option-card-wrapper"><div on:click="changeTheme('护眼')" class="option-card" style="background-color: #332b20;"><text style="color: #f4e6c8; font-size: 28px;">护</text></div></list-item></list></div></list-item>
    <list-item class="main-card-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 204px;"><div class="main-card" style="width: {{uiSizes.uiWidth}}px; height: 192px;"><text class="main-card-title">字体大小</text><div class="option-list" style="width: {{uiSizes.uiWidth}}px; height: 84px;"><div on:click="changeFontSize('26px')" class="option-card-wrapper"><div class="option-card" style="background-color: #333;"><text style="font-size: 26px;">小</text></div></div><div on:click="changeFontSize('30px')" class="option-card-wrapper"><div class="option-card" style="background-color: #333;"><text style="font-size: 30px;">中</text></div></div><div on:click="changeFontSize('38px')" class="option-card-wrapper"><div class="option-card" style="background-color: #333;"><text style="font-size: 38px;">大</text></div></div></div></div></list-item>
    <list-item class="main-card-wrapper" style="width: {{uiSizes.screenWidth}}px; height: 180px;"><div class="main-card" style="width: {{uiSizes.uiWidth}}px; height: 180px;"><text class="main-card-title">自动翻页速度</text><div class="option-list" style="width: {{uiSizes.uiWidth}}px; height: 72px;"><div on:click="speedDown" class="option-round-btn"><text style="font-size: 30px;">-</text></div><text style="margin-left: 24px; margin-right: 12px; font-size: 30px;">{{autoPagerSpeed}}秒</text><div on:click="speedUp" class="option-round-btn"><text style="font-size: 30px;">+</text></div></div></div></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 52px; justify-content: center;"><text class="text-30px text-gray">按键/触控功能（点一项循环）</text></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 58px; justify-content: center;"><div on:click="cycle('tapLeft')" class="button-row" style="width: {{uiSizes.uiWidth}}px;"><text>左侧轻触</text><text>{{tapLeft}}</text></div></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 58px; justify-content: center;"><div on:click="cycle('tapRight')" class="button-row" style="width: {{uiSizes.uiWidth}}px;"><text>右侧轻触</text><text>{{tapRight}}</text></div></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 58px; justify-content: center;"><div on:click="cycle('holdLeft')" class="button-row" style="width: {{uiSizes.uiWidth}}px;"><text>左侧长按</text><text>{{holdLeft}}</text></div></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 58px; justify-content: center;"><div on:click="cycle('holdRight')" class="button-row" style="width: {{uiSizes.uiWidth}}px;"><text>右侧长按</text><text>{{holdRight}}</text></div></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 58px; justify-content: center;"><div on:click="cycle('swipeLeft')" class="button-row" style="width: {{uiSizes.uiWidth}}px;"><text>向左滑</text><text>{{swipeLeft}}</text></div></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 58px; justify-content: center;"><div on:click="cycle('swipeRight')" class="button-row" style="width: {{uiSizes.uiWidth}}px;"><text>向右滑</text><text>{{swipeRight}}</text></div></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 58px; justify-content: center;"><div on:click="cycle('swipeUp')" class="button-row" style="width: {{uiSizes.uiWidth}}px;"><text>向上滑</text><text>{{swipeUp}}</text></div></list-item>
    <list-item style="width: {{uiSizes.screenWidth}}px; height: 58px; justify-content: center;"><div on:click="cycle('swipeDown')" class="button-row" style="width: {{uiSizes.uiWidth}}px;"><text>向下滑</text><text>{{swipeDown}}</text></div></list-item>
    <list-item style="width: 0px; height: {{uiSizes.topMargin}}px;"></list-item>
  </list>
</div>
